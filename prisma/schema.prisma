generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  responsible_name String
  email            String   @unique
  password_hash    String
  cep              String
  address          String
  city             String
  whatsapp         String
  created_at       DateTime @default(now())

  @@map("organizations")
}